<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_document_view_list" model="ir.ui.view">
        <field name="name">l10n_mx_sat.document.list</field>
        <field name="model">l10n_mx_sat.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="uuid" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="document_kind" />
                <field name="direction" />
                <field name="sat_status" widget="badge" />
                <field name="voucher_type" />
                <field name="issuer_rfc" />
                <field name="receiver_rfc" />
                <field name="issue_date" />
                <field name="total" />
                <field name="has_xml" />
            </list>
        </field>
    </record>

    <record id="l10n_mx_sat_document_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.document.form</field>
        <field name="model">l10n_mx_sat.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_download_xml"
                        type="object"
                        string="Download XML"
                        class="btn-primary"
                        invisible="not has_xml"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="uuid" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="document_kind" />
                            <field name="direction" />
                            <field name="sat_status" />
                            <field name="voucher_type" />
                        </group>
                        <group>
                            <field name="issuer_rfc" />
                            <field name="issuer_name" />
                            <field name="receiver_rfc" />
                            <field name="receiver_name" />
                            <field name="issue_date" />
                            <field name="stamp_date" />
                            <field name="cancellation_date" />
                            <field name="total" />
                            <field name="currency_code" />
                            <field name="series" />
                            <field name="folio_number" />
                            <field name="has_xml" />
                            <field name="download_request_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_mx_sat_document_view_search" model="ir.ui.view">
        <field name="name">l10n_mx_sat.document.search</field>
        <field name="model">l10n_mx_sat.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid" />
                <field name="issuer_rfc" />
                <field name="receiver_rfc" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    string="Valid"
                    name="valid"
                    domain="[('sat_status', '=', 'valid')]"
                />
                <filter
                    string="Cancelled"
                    name="cancelled"
                    domain="[('sat_status', '=', 'cancelled')]"
                />
                <filter
                    string="In progress"
                    name="in_progress"
                    domain="[('sat_status', '=', 'in_progress')]"
                />
                <filter
                    string="With XML"
                    name="has_xml"
                    domain="[('has_xml', '=', True)]"
                />
                <filter
                    string="Without XML"
                    name="no_xml"
                    domain="[('has_xml', '=', False)]"
                />
                <separator />
                <filter
                    string="CFDI"
                    name="cfdi"
                    domain="[('document_kind', '=', 'cfdi')]"
                />
                <filter
                    string="Retention"
                    name="retention"
                    domain="[('document_kind', '=', 'retention')]"
                />
                <separator />
                <filter
                    string="Issued"
                    name="issued"
                    domain="[('direction', '=', 'issued')]"
                />
                <filter
                    string="Received"
                    name="received"
                    domain="[('direction', '=', 'received')]"
                />
                <group expand="0" string="Group by">
                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        string="SAT status"
                        name="group_status"
                        context="{'group_by': 'sat_status'}"
                    />
                    <filter
                        string="Type"
                        name="group_kind"
                        context="{'group_by': 'document_kind'}"
                    />
                    <filter
                        string="Direction"
                        name="group_direction"
                        context="{'group_by': 'direction'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_mx_sat_document_action" model="ir.actions.act_window">
        <field name="name">SAT documents</field>
        <field name="res_model">l10n_mx_sat.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_mx_sat_document_view_search" />
    </record>
</odoo>
